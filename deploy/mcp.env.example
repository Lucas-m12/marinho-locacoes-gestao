# Variáveis do contêiner mcp (MCP do Claude). Na VPS, este arquivo vira
# /opt/marinho/mcp.env, com permissão 600. Ele é separado do .env de
# propósito: o mcp não recebe a senha do banco, as chaves do R2 nem o segredo
# do login. Passo a passo em apps/mcp/README.md.
# Escreva cada comentário numa linha própria, nunca depois do valor.

# Token que o conector do Claude manda no cabeçalho Authorization.
# Gere com: openssl rand -hex 32
# Trocar este valor desconecta o conector até você colar o novo no claude.ai.
MCP_TOKEN=

# Usuário do Claude no sistema (papel Atendimento) e a senha dele.
MARINHO_USUARIO=claude
MARINHO_SENHA=

# leitura: só consultas. completo: também orçamento, pagamento, cancelamento…
MARINHO_MCP_MODO=leitura
