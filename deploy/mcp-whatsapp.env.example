# Variáveis do contêiner mcp-whatsapp (MCP do agente do WhatsApp). Na VPS,
# este arquivo vira /opt/marinho/mcp-whatsapp.env, com permissão 600. É
# separado do mcp.env de propósito: o agente tem usuário, token e modo próprios,
# e trocar um não mexe no conector do Claude.
# Escreva cada comentário numa linha própria, nunca depois do valor.

# Token que o OpenClaw manda no cabeçalho Authorization.
# Gere com: openssl rand -hex 32
MCP_TOKEN=

# Usuário do agente no sistema (papel Atendimento) e a senha dele.
MARINHO_USUARIO=whatsapp
MARINHO_SENHA=

# leitura: só consultas. completo: também orçamento, pagamento, cancelamento…
MARINHO_MCP_MODO=leitura
