{
	email {$ACME_EMAIL}
	log {
		output stdout
		format json
	}
}

{$API_DOMAIN} {
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Resource-Policy "same-site"
		-Server
	}

	log {
		output stdout
		format json
	}

	# MCP do Claude: só os IPs de saída da Anthropic chegam ao contêiner mcp;
	# qualquer outro recebe 404. O contêiner ainda exige o token.
	@mcp path /mcp /mcp/*
	handle @mcp {
		@fora_da_anthropic not remote_ip {$MCP_ALLOWED_IPS:160.79.104.0/21 153.61.208.0/20}
		respond @fora_da_anthropic 404
		reverse_proxy mcp:3000
	}

	handle {
		encode zstd gzip
		reverse_proxy server:3000
	}
}
