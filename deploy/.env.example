# Variáveis de produção. Na VPS, este arquivo vira /opt/marinho/.env:
#   cp .env.example /opt/marinho/.env && chmod 600 /opt/marinho/.env
# Preencha os valores lá. Nunca envie o arquivo preenchido para o repositório.
# O Docker Compose lê este arquivo duas vezes: para montar o docker-compose.yml
# (IMAGE_TAG, POSTGRES_PASSWORD...) e como ambiente do server, jobs e migrate.
# Escreva cada comentário numa linha própria, nunca depois do valor.

# ---------------------------------------------------------------------------
# Imagem
# ---------------------------------------------------------------------------

# Imagem do servidor no GitHub Container Registry, com o dono do repositório
# em letras minúsculas.
SERVER_IMAGE=ghcr.io/lucas-m12/marinho-gestao-server

# Versão em produção (sha-<commit>). O deploy.sh reescreve esta linha a cada
# deploy e rollback; não precisa mexer à mão.
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Domínio e certificado (Caddy)
# ---------------------------------------------------------------------------

# Endereço da API. O registro A dele no DNS da Cloudflare fica sem proxy
# (nuvem cinza), para o Caddy emitir o certificado do Let's Encrypt.
API_DOMAIN=api.marinholocacoes.com

# E-mail que recebe os avisos do Let's Encrypt (certificado perto de vencer).
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------

# Senha do usuário "marinho" do banco. Gere com: openssl rand -hex 32
# Use só letras e números: ela entra na DATABASE_URL, montada no compose.
# Ela vale a partir da primeira subida do Postgres; trocar aqui depois não
# muda a senha dentro do banco (veja docs/operacao/rotina.md).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# API e login
# ---------------------------------------------------------------------------

# Chave que assina as sessões. Gere com: openssl rand -base64 48
# Trocar esta chave desconecta todo mundo.
BETTER_AUTH_SECRET=

# Endereço público da API (com https e sem barra no fim).
BETTER_AUTH_URL=https://api.marinholocacoes.com

# Endereço do front, a única origem que pode chamar a API pelo navegador.
CORS_ORIGIN=https://sistema.marinholocacoes.com

# ---------------------------------------------------------------------------
# Cloudflare R2: arquivos enviados pelo sistema (bucket marinho-prod)
# ---------------------------------------------------------------------------

# Painel da Cloudflare → R2 → "Account ID".
R2_ACCOUNT_ID=

# Token "Object Read & Write" restrito ao bucket marinho-prod.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marinho-prod

# Deixe vazio em produção (só serve para testes com um S3 falso).
R2_ENDPOINT=

# ---------------------------------------------------------------------------
# Cloudflare R2: backups do Postgres (bucket marinho-backups)
# ---------------------------------------------------------------------------

# Token "Object Read & Write" restrito ao bucket marinho-backups.
# É outro token: quem tem o token dos uploads não mexe nos backups.
R2_BACKUP_BUCKET=marinho-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
