model Settings {
  id                      Int         @id @default(1)
  signalMode              SignalMode? @map("signal_mode")
  signalValueCents        Int?        @map("signal_value_cents")
  signalPercent           Float?      @map("signal_percent")
  signalDeadlineHours     Int         @map("signal_deadline_hours")
  defaultTurnaroundHours  Int         @map("default_turnaround_hours")
  documentRetentionMonths Int         @default(24) @map("document_retention_months")
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

model DeliveryFee {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  city     String @unique
  feeCents Int?   @map("fee_cents")
  position Int

  @@map("delivery_fee")
}
