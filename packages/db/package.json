{
	"name": "@marinho-gestao/db",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"db:push": "prisma db push",
		"db:generate": "bun run scripts/generate-enums.ts && prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "varlock run -- bun run prisma/seed.ts",
		"db:seed:demo": "varlock run -- bun run prisma/seed-demo.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@marinho-gestao/domain": "workspace:*",
		"@marinho-gestao/read-model": "workspace:*",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"better-auth": "catalog:",
		"pg": "^8.23.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@marinho-gestao/config": "workspace:*",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.0",
		"typescript": "catalog:",
		"varlock": "catalog:",
		"vitest": "catalog:"
	}
}
