{
	"name": "marinho-gestao",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.3",
			"varlock": "1.23.0",
			"@orpc/server": "^1.15.6",
			"@orpc/openapi": "^1.15.6",
			"@orpc/zod": "^1.15.6",
			"better-auth": "1.7.12",
			"sonner": "^2.0.8",
			"@orpc/client": "^1.15.6",
			"tailwindcss": "^4.3.3",
			"@orpc/contract": "^1.15.6",
			"vitest": "^5.0.5"
		}
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.6"
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:server": "bun run db:test:start && bun run --cwd packages/api test:server && bun run --cwd apps/server test:server",
		"e2e": "bun run --cwd apps/e2e e2e",
		"e2e:ui": "bun run --cwd apps/e2e e2e:ui",
		"e2e:mock": "bun run --cwd apps/e2e e2e:mock",
		"e2e:visual": "bun run --cwd apps/e2e e2e:visual",
		"e2e:update": "apps/e2e/scripts/update-snapshots.sh",
		"dev:web": "turbo run dev:bare -F web --",
		"dev:server": "turbo run dev -F server --",
		"jobs": "bun run --cwd apps/server jobs",
		"job": "bun run --cwd apps/server job",
		"db:push": "turbo run db:push -F @marinho-gestao/db --",
		"db:studio": "turbo run db:studio -F @marinho-gestao/db --",
		"db:generate": "turbo run db:generate -F @marinho-gestao/db --",
		"db:migrate": "turbo run db:migrate -F @marinho-gestao/db --",
		"db:migrate:deploy": "cd packages/db && bun run db:migrate:deploy",
		"db:seed": "cd packages/db && bun run db:seed",
		"db:seed:demo": "cd packages/db && bun run db:seed:demo",
		"db:start": "docker compose up -d postgres",
		"db:watch": "docker compose up postgres",
		"db:stop": "docker compose stop postgres",
		"db:down": "docker compose down postgres",
		"db:test:start": "docker compose --profile test up -d --wait postgres-test",
		"db:test:stop": "docker compose --profile test rm -sf postgres-test",
		"storage:start": "docker compose --profile dev up -d --wait minio && bun apps/e2e/scripts/minio.ts",
		"storage:stop": "docker compose --profile dev stop minio",
		"deploy": "turbo run deploy -F @marinho-gestao/infra --",
		"destroy": "turbo run destroy -F @marinho-gestao/infra --",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@cloudflare/workers-types": "^5.20260906.1",
		"@marinho-gestao/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.4"
}
