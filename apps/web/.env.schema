# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# De onde as telas leem os dados: mock (no navegador) ou http (backend real)
# @public @type=enum(mock, http)
VITE_DATA_SOURCE=mock

# Só é usada em http
# @public @type=url @required=eq($VITE_DATA_SOURCE, "http")
VITE_SERVER_URL=

# Sentry do front. Vazio desliga o envio de erros (desenvolvimento e mock).
# @public @optional @type=url
VITE_SENTRY_DSN=

# Sha do commit, preenchido pelo deploy, para o Sentry saber a versão.
# @public @optional
VITE_SENTRY_RELEASE=

# @public @optional
VITE_SENTRY_ENVIRONMENT=
