{
	"extends": "@marinho-gestao/config/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"rootDirs": ["."],
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@marinho-gestao/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts"]
}
