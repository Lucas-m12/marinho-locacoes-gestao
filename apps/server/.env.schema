# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(eq($NODE_ENV, production)))
# ---
# O varlock esconde dos logs e bloqueia nas respostas todo valor sensível.
# Só é sensível o que é segredo de verdade: endereços, nomes de bucket e IDs
# de chave aparecem nas URLs que a API devolve e ficam com @sensitive=false.

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @sensitive=false @type=url
BETTER_AUTH_URL=

# @sensitive=false @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Cloudflare R2: bucket privado dos uploads (ADR 0012).
# Em desenvolvimento use o bucket marinho-dev. Veja docs/operacao/r2.md.
# O Account ID, o bucket e o Access Key ID vão dentro de toda URL assinada.
# @sensitive=false @type=string(minLength=1)
R2_ACCOUNT_ID=

# @sensitive=false @type=string(minLength=1)
R2_ACCESS_KEY_ID=

# @type=string(minLength=1)
R2_SECRET_ACCESS_KEY=

# @sensitive=false @type=string(minLength=1)
R2_BUCKET=

# Só para testes locais com um S3 falso. Em produção fica vazio e o endereço vem do R2_ACCOUNT_ID.
# @optional @sensitive=false @type=url
R2_ENDPOINT=

# Liga o relógio de teste e as rotas /__test/* do E2E. Proibido em produção: o servidor não sobe.
# @optional @sensitive=false @type=boolean
E2E_TEST_HOOKS=

# Sentry da API e das tarefas. Vazio desliga o envio de erros.
# @optional @sensitive=false @type=url
SENTRY_DSN=

# Sha do commit, gravado na imagem pelo build (vira o release do Sentry).
# @optional @sensitive=false
GIT_SHA=

# Bucket dos backups do Postgres (marinho-backups), com token próprio restrito a ele.
# Só a tarefa backup-database usa. Veja docs/operacao/r2.md.
# @optional @sensitive=false
R2_BACKUP_BUCKET=

# @optional @sensitive=false
R2_BACKUP_ACCESS_KEY_ID=

# @optional
R2_BACKUP_SECRET_ACCESS_KEY=
